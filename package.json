{
  "name": "gamehub",
  "version": "1.0.1",
  "author": "GameHub Team",
  "license": "MIT",
  "description": "Unified PC Game Library & Launcher",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"vite,electron\" -c \"blue,magenta\" \"vite\" \"node scripts/dev-electron.js\"",
    "dev:test": "concurrently -k -n \"vite,electron\" -c \"blue,magenta\" \"vite\" \"node scripts/dev-electron.js --test-launch\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/dev-electron.js",
    "build": "node scripts/build-electron.js && vite build",
    "build:electron": "node scripts/build-electron.js",
    "package": "node scripts/build-electron.js && vite build && electron-builder --dir",
    "dist": "node scripts/build-electron.js && vite build && electron-builder",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
